{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "description": "Mintmaker/Renovate config for the dragonfly/tools repo. For shared presets used by other repos, see renovate-config/.",
    "tekton": {
        "description": "Schedule on weekdays at night (10 PM - 4 AM) and anytime on weekends",
        "schedule": [
            "* 22-23,0-4 * * *",
            "* * * * 0,6"
        ],
        "managerFilePatterns": [
            "/\\.yaml$/"
        ],
        "includePaths": [
            "shared-tekton-pipelines/**"
        ],
        "automerge": true
    },
    "dockerfile": {
        "description": "Automerge Containerfile image updates",
        "managerFilePatterns": [
            "/(^|/)Containerfile.*$/"
        ],
        "automerge": true
    }
}
