{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "tekton": {
        "description": "Schedule on weekdays at night (10 PM - 4 AM) and anytime on weekends",
        "schedule": [
            "* 22-23,0-4 * * *",
            "* * * * 0,6"
        ],
        "fileMatch": [
            "\\.yaml$"
        ],
        "includePaths": [
            "shared-tekton-pipelines-rhwa/**"
        ],
        "automerge": true
    }
}