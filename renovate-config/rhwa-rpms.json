{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "description": [
        "RHWA preset for RHWA repos with RPMs and external packages dependencies"
    ],
    "extends": [
        "github>konflux-ci/mintmaker-presets:refresh-rpm-lockfiles"
    ],
    "git-submodules": {
        "description": [
            "Schedule git-submodules changes on any time Mintmaker is available (every 4 hours) and auto-merge them"
        ],
        "schedule": [
            "at any time"
        ]
    },
    "dockerfile": {
        "description": [
            "Schedule Containerfile changes on any time Mintmaker is available (every 4 hours) and auto-merge them after updating the RPM lockfile"
        ],
        "schedule": [
            "at any time"
        ],
        "managerFilePatterns": [
            "/(^|/)Containerfile.*$/"
        ]
    },
    "rpm-lockfile": {
        "description": [
            "Schedule RPM lockfile changes on any time Mintmaker is available (every 4 hours) and auto-merge them"
        ],
        "schedule": [
            "at any time"
        ]
    },
    "allowedCommands": [
        "^\\[ ! -x scripts/update-tekton-params\\.sh \\] \\|\\| scripts/update-tekton-params\\.sh$"
    ],
    "packageRules": [
        {
            "description": [
                "Automerge everything"
            ],
            "matchManagers": [
                "git-submodules",
                "dockerfile",
                "rpm-lockfile"
            ],
            "automerge": true
        },
        {
            "description": [
                "Update .tekton params when submodule updates"
            ],
            "matchManagers": [
                "git-submodules"
            ],
            "postUpgradeTasks": {
                "commands": [
                    "[ ! -x scripts/update-tekton-params.sh ] || scripts/update-tekton-params.sh"
                ],
                "fileFilters": [
                    ".tekton/**"
                ],
                "executionMode": "branch"
            }
        }
    ]
}